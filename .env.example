# Copy to .env and fill in. .env is gitignored.

# GitHub personal access token, no special scopes needed for public repos
# (classic PAT with no scopes, or fine-grained PAT with public-repo read access).
# Required for: job log downloads (403 without auth even on public repos),
# and to get the 5,000 req/hr authenticated rate limit instead of 60/hr.
GITHUB_TOKEN=

# Local Postgres started via docker-compose.yml
DATABASE_URL=postgresql://winnow:winnow_dev_local_only@localhost:5433/winnow

# Where raw fetched logs land locally before Phase 5 moves this to S3.
WINNOW_LOG_DIR=data/logs
